# purplhrtz — copy to .env.local and fill in. Everything is optional:
# without Stripe the shop runs a labelled demo checkout; without Supabase the
# corkboard keeps notes on the visitor's device only.

# Public origin used for Stripe redirect URLs (falls back to the request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (use a sandbox/test key while developing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Supabase (shared guestbook + order records) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only token checked by the database functions (store only its sha256 in private.settings)
SUPABASE_SERVER_RPC_TOKEN=
# Salt for hashing visitor IPs before rate limiting (never stored in clear)
NOTES_IP_SALT=

# HMAC secret for signed, expiring download links
DOWNLOAD_SIGNING_SECRET=
